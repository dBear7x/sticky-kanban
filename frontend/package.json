{
  "name": "kanban-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend for Kanban-style sticky notes. Polls backend for letters and displays them as modern, randomized sticky notes.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.4.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^3.4.7",
    "postcss": "^8.4.24",
    "autoprefixer": "^10.4.14",
    "prettier": "^2.8.8"
  },
  "engines": {
    "node": ">=14"
  },
  "keywords": [
    "kanban",
    "sticky-notes",
    "letters",
    "react",
    "vite",
    "tailwind"
  ]
}
